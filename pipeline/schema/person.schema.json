{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roquena71-a11y.github.io/kauffmann-list/api/v1/schema/person.schema.json",
  "title": "Kauffmann List person record",
  "description": "Common record for a person persecuted by National Socialism (victim of the Shoah or other persecuted groups), merged from one or more sources. Every record must carry provenance and licence in sources[]; field_sources says which source provided each top-level value.",
  "type": "object",
  "required": [
    "id",
    "name",
    "fate",
    "sources",
    "field_sources"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "description": "Stable id with a source prefix: wd-<Qid> when the person has a Wikidata item, otherwise <source prefix>-<record id> (e.g. st-n10010972992).",
      "pattern": "^[a-z][a-z0-9]*-[A-Za-z0-9_.:-]+$"
    },
    "alternate_ids": {
      "type": "array",
      "description": "Other ids under which the same person was known (merged records, previous ids).",
      "items": {
        "type": "string"
      }
    },
    "subject_type": {
      "type": "string",
      "enum": [
        "person",
        "collective"
      ],
      "description": "collective = memorial for a group (e.g. a Stolperschwelle) rather than one person. Omitted when 'person' (default).",
      "default": "person"
    },
    "name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Full display name as given by the source (null when the memorial is anonymous)."
    },
    "given_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "family_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "birth_name": {
      "type": [
        "string",
        "null"
      ],
      "description": "Family name at birth (German 'geb.')."
    },
    "birth_date": {
      "$ref": "#/$defs/partialDate"
    },
    "birth_place": {
      "type": [
        "string",
        "null"
      ]
    },
    "death_date": {
      "$ref": "#/$defs/partialDate"
    },
    "death_place": {
      "type": [
        "string",
        "null"
      ]
    },
    "fate": {
      "type": "string",
      "enum": [
        "murdered",
        "died_in_persecution",
        "suicide",
        "missing",
        "survived",
        "fled",
        "deported",
        "imprisoned",
        "unknown"
      ],
      "description": "Best-supported fate. Derived conservatively; 'unknown' when no evidence."
    },
    "fate_basis": {
      "type": [
        "string",
        "null"
      ],
      "description": "How fate was derived: inscription_keywords, wikidata_manner_of_death, wikidata_place_of_death, source_field."
    },
    "deportations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "$ref": "#/$defs/partialDate"
          },
          "from": {
            "type": [
              "string",
              "null"
            ]
          },
          "place": {
            "type": [
              "string",
              "null"
            ]
          },
          "raw": {
            "type": [
              "string",
              "null"
            ],
            "description": "Original wording in the source."
          },
          "source_id": {
            "type": "string"
          }
        }
      }
    },
    "places": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "label",
          "source_id"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "residence",
              "birth",
              "deportation",
              "death",
              "memorial"
            ]
          },
          "label": {
            "type": "string"
          },
          "locality": {
            "type": [
              "string",
              "null"
            ]
          },
          "lat": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -180,
            "maximum": 180
          },
          "country": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{2}$",
            "description": "ISO 3166-1 alpha-2"
          },
          "wikidata": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^Q[0-9]+$"
          },
          "source_id": {
            "type": "string"
          }
        }
      }
    },
    "memorials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "source_id"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "stolperstein",
              "stolperschwelle",
              "memorial"
            ]
          },
          "memorial_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "Id of the memorial object (OSM n/w id or Wikidata Qid)."
          },
          "inscription": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "locality": {
            "type": [
              "string",
              "null"
            ]
          },
          "country": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[A-Z]{2}$"
          },
          "lat": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -180,
            "maximum": 180
          },
          "laid": {
            "$ref": "#/$defs/partialDate"
          },
          "image": {
            "type": [
              "string",
              "null"
            ],
            "description": "Wikimedia Commons file page or image URL (linked, not copied)."
          },
          "source_id": {
            "type": "string"
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "url",
          "source_id"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "description": "e.g. gedenkbuch, yad_vashem, ushmm, arolsen, local_biography, described_at, website, wikipedia, wikipedia_list_entry, wikidata, openstreetmap"
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ],
            "description": "Licence of the linked content when it is known and relevant (e.g. CC BY-SA 4.0 for Wikipedia text)."
          },
          "text_url": {
            "type": [
              "string",
              "null"
            ],
            "description": "Site-relative URL of a licensed text extract kept elsewhere in this site."
          },
          "source_id": {
            "type": "string"
          }
        }
      }
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wikidata": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^Q[0-9]+$"
        },
        "gedenkbuch": {
          "$ref": "#/$defs/idList"
        },
        "yad_vashem": {
          "$ref": "#/$defs/idList"
        },
        "ushmm": {
          "$ref": "#/$defs/idList"
        },
        "arolsen": {
          "$ref": "#/$defs/idList"
        },
        "holocaust_cz": {
          "$ref": "#/$defs/idList"
        },
        "joods_monument": {
          "$ref": "#/$defs/idList"
        },
        "osm": {
          "$ref": "#/$defs/idList"
        },
        "mapping_the_lives": {
          "$ref": "#/$defs/idList"
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "record_id",
          "license",
          "attribution"
        ],
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "description": "SPDX-like licence id, e.g. ODbL-1.0, CC0-1.0, CC-BY-SA-4.0"
          },
          "license_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "attribution": {
            "type": "string",
            "minLength": 1
          },
          "retrieved": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "field_sources": {
      "type": "object",
      "description": "For every top-level scalar field that has a value (except fate_basis/subject_type): the source_ids that provided that exact value.",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1
      }
    },
    "variants": {
      "type": "object",
      "description": "Values that disagree with the chosen one, kept with their source (never silently discarded).",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "value",
            "source_id"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": [
                "string",
                "number",
                "null"
              ]
            },
            "source_id": {
              "type": "string"
            }
          }
        }
      }
    },
    "restrictions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "survivor_minimization"
        ]
      },
      "description": "Políticas aplicadas al publicar (p. ej. survivor_minimization: sin enlaces a fichas de registro)."
    },
    "quality_flags": {
      "type": "array",
      "description": "Problemas de calidad detectados (el dato NO se corrige; verificar en la fuente).",
      "items": {
        "type": "string",
        "enum": [
          "birth_before_1800",
          "birth_after_data_year",
          "death_before_1800",
          "death_after_data_year",
          "birth_after_death"
        ]
      }
    }
  },
  "$defs": {
    "partialDate": {
      "type": [
        "string",
        "null"
      ],
      "description": "ISO 8601 date with optional precision: YYYY, YYYY-MM or YYYY-MM-DD.",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
    },
    "idList": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
