    {
      "@type": "Project",
      "@id": "#project",
      "name": "Kauffmann List",
      "url": "https://roquena71-a11y.github.io/kauffmann-list/proyecto/",
      "creativeWorkStatus": "In preparation",
      "founder": {"@type": "Person", "name": "Carlos Kauffmann"},
      "contactPoint": {"@type": "ContactPoint", "email": "listakauffmann@gmail.com"},
      "description": "Goal: no stone and no victim left out. Status 2026-11-20, in preparation, not published: 72,110 stones in 27 countries (65,834 in Germany) mapped from open data; an estimated 40,000+ German stones are not yet in open data (Stiftung Spuren counts 116,000+ in 31 countries). No charitable status is claimed and no partnership is agreed. Biography texts shown only from Wikipedia CC BY-SA on a certain match (4,038, Germany only); official pages and archive records are linked, not copied. Pending: public release."
    },
    {
      "@type": "WebPage",
