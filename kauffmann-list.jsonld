    {
      "@type": "Project",
      "@id": "#project",
      "name": "Kauffmann List",
      "url": "https://roquena71-a11y.github.io/kauffmann-list/proyecto/",
      "creativeWorkStatus": "In preparation",
      "founder": {
        "@type": "Person",
        "name": "Carlos Kauffmann"
      },
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "listakauffmann@gmail.com"
      },
      "description": "Goal: no stone and no victim left out. Status 2026-11-24, in preparation, not published: 72,110 stones (ODbL, OpenStreetMap + Wikidata) plus 290 from Berlin Open Data, 1,550 from Köln Open.NRW, and 1,172 from 13 municipal open-data lists added in v22 (map total 75,122) in 27 countries (68,279 in Germany, of which 65,830 are in the ODbL dataset; 1,590 in the Netherlands; 731 in Italy) mapped from open data; an estimated 40,000+ German stones are not yet in open data (Stiftung Spuren counts 116,000+ in 31 countries). No charitable status is claimed and no partnership is agreed. Biography texts shown only from Wikipedia CC BY-SA on a certain match (4,038, Germany only); official pages and archive records are linked, not copied. Pending: public release."
    },
    {
      "@type": "WebPage",
      "@id": "https://roquena71-a11y.github.io/kauffmann-list/proyecto/#webpage",
      "url": "https://roquena71-a11y.github.io/kauffmann-list/proyecto/",
      "name": "Kauffmann-Liste — für Institutionen",
      "inLanguage": [
        "de",
        "en",
        "es"
      ],
      "isAccessibleForFree": true,
      "creativeWorkStatus": "In preparation",
      "about": {
        "@id": "#project"
      },
      "description": "Draft page for institutions asked to collaborate. Not published. No partnership is agreed and no charitable status is claimed. States what the Kauffmann List is, the measured coverage on 20 November 2026, the principles, and what is asked, including how attribution would look."
    }
