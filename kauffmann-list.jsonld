    {
      "@type": "Dataset",
      "@id": "#dataset",
      "name": "Kauffmann List – Stolpersteine in Germany and 26 other European countries",
      "alternateName": ["Lista Kauffmann", "Kauffmann-Liste", "Stolpersteine", "Stumbling Stones", "אבני נגף"],
      "description": "Open, searchable map and dataset of the Stolpersteine (memorial plaques for victims of National Socialism) that open data (OpenStreetMap, Wikidata) allows us to verify in Germany, Netherlands, France, Austria, Norway, Czechia, Italy, Spain, Belgium, Luxembourg, Hungary, Lithuania, Switzerland, Poland, Slovakia, Jersey, Croatia, Denmark, Guernsey, Finland, Andorra, Ireland, Sweden, Latvia, Romania, United Kingdom and Liechtenstein, so families anywhere can find a plaque by name, surname or address and see its data and story. Motto: Cada placa, cada nombre, cada historia. Nunca olvidar.",
      "inLanguage": ["es", "de", "en"],
      "keywords": ["Stolpersteine", "Stumbling Stones", "Holocaust", "Shoah", "memorial", "Germany", "Netherlands", "France", "Austria", "Norway", "Czechia", "Italy", "Spain", "Belgium", "Luxembourg", "Hungary", "Lithuania", "Switzerland", "Poland", "Slovakia", "Jersey", "Croatia", "Denmark", "Guernsey", "Finland", "Andorra", "Ireland", "Sweden", "Latvia", "Romania", "United Kingdom", "Liechtenstein", "genealogy", "victims of National Socialism", "Gunter Demnig", "map"],
      "creator": {"@type": "Person", "name": "Carlos Kauffmann"},
