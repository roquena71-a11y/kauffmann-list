    {
      "@type": "WebAPI",
      "@id": "#api",
      "name": "Lista Kauffmann – static JSON API",
      "description": "Read-only static JSON files (GET): search by name, place and year; person records with sources and licence. Cite Lista Kauffmann + person link + original source. Never invent data.",
      "documentation": [
        "https://roquena71-a11y.github.io/kauffmann-list/llms.txt",
        "https://roquena71-a11y.github.io/kauffmann-list/llms-full.txt"
      ],
      "url": "https://roquena71-a11y.github.io/kauffmann-list/api/v1/",
      "isAccessibleForFree": true,
      "termsOfService": "https://roquena71-a11y.github.io/kauffmann-list/llms.txt",
      "provider": {
        "@type": "Person",
        "name": "Carlos Kauffmann"
      },
      "potentialAction": {
        "@type": "SearchAction",
        "target": "https://roquena71-a11y.github.io/kauffmann-list/?q={search_term_string}",
        "query-input": "required name=search_term_string"
      }
    },
    {
      "@type": "WebApplication",
      "@id": "#app",
      "name": "Lista Kauffmann",
      "applicationCategory": "ReferenceApplication",
      "operatingSystem": "Any (web browser, installable PWA)",
      "inLanguage": [
        "es",
        "de",
        "en"
      ],
      "isAccessibleForFree": true,
      "offers": {
        "@type": "Offer",
        "price": 0,
        "priceCurrency": "EUR"
      },
      "featureList": [
        "Search by first name, surname or address with camera fly-to",
        "3D golden column for every Stolperstein",
        "1945 / today aerial comparison slider (1945 currently Bremerhaven only)",
        "Highest-resolution official state orthophotos (10–20 cm) as today's view",
        "'Recordar a todos' remembrance mode",
        "Links to Bundesarchiv Gedenkbuch, Yad Vashem and USHMM records",
        "Google Earth KML/KMZ, GeoJSON and CSV downloads"
      ],
      "mainEntity": {
        "@id": "#dataset"
      },
      "creator": {
        "@type": "Person",
        "name": "Carlos Kauffmann"
      }
