      "isAccessibleForFree": true,
      "offers": {"@type": "Offer", "price": 0, "priceCurrency": "EUR"},
      "featureList": [
        "Search by first name, surname or address with camera fly-to",
        "3D golden column for every Stolperstein",
        "1945 / today aerial comparison slider (1945 currently Bremerhaven only)",
        "Highest-resolution official state orthophotos (10–20 cm) as today's view",
        "'Recordar a todos' remembrance mode",
        "Links to Bundesarchiv Gedenkbuch, Yad Vashem and USHMM records",
        "Google Earth KML/KMZ, GeoJSON and CSV downloads"
      ],
      "mainEntity": {"@id": "#dataset"},
      "creator": {"@type": "Person", "name": "Carlos Kauffmann"}
    },
    {
      "@type": "Project",
      "@id": "#project",
      "name": "Kauffmann List",
      "url": "https://roquena71-a11y.github.io/kauffmann-list/proyecto/",
      "creativeWorkStatus": "In preparation",
      "founder": {"@type": "Person", "name": "Carlos Kauffmann"},
      "contactPoint": {"@type": "ContactPoint", "email": "listakauffmann@gmail.com"},
      "description": "Goal: no stone and no victim left out. Status 2026-11-18, in preparation, not published: 65,820 stones mapped from open data; an estimated 40,000+ German stones are not yet in open data (Stiftung Spuren counts 116,000+ in 31 countries). No charitable status is claimed and no partnership is agreed. Biography texts shown only from Wikipedia CC BY-SA on a certain match (4,038); official pages and archive records are linked, not copied. Pending: public release."
    },
    {
      "@type": "WebPage",
      "@id": "https://roquena71-a11y.github.io/kauffmann-list/proyecto/#webpage",
      "url": "https://roquena71-a11y.github.io/kauffmann-list/proyecto/",
      "name": "Kauffmann-Liste — für Institutionen",
      "inLanguage": ["de", "en", "es"],
      "isAccessibleForFree": true,
      "creativeWorkStatus": "In preparation",
      "about": {"@id": "#project"},
      "description": "Draft page for institutions asked to collaborate. Not published. No partnership is agreed and no charitable status is claimed. States what the Kauffmann List is, the measured coverage on 18 November 2026, the principles, and what is asked, including how attribution would look."
    }
