      "url": "https://roquena71-a11y.github.io/kauffmann-list/proyecto/",
      "name": "Kauffmann-Liste — für Institutionen",
      "inLanguage": ["de", "en", "es"],
      "isAccessibleForFree": true,
      "creativeWorkStatus": "In preparation",
      "about": {"@id": "#project"},
      "description": "Draft page for institutions asked to collaborate. Not published. No partnership is agreed and no charitable status is claimed. States what the Kauffmann List is, the measured coverage on 20 November 2026, the principles, and what is asked, including how attribution would look."
    }
