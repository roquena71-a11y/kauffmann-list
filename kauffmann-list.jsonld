{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Dataset",
      "@id": "#dataset",
      "name": "Kauffmann List – Stolpersteine in Germany",
      "alternateName": ["Lista Kauffmann", "Kauffmann-Liste", "Stolpersteine", "Stumbling Stones", "אבני נגף"],
      "description": "Open, searchable map and dataset of every Stolperstein (memorial plaque for victims of National Socialism) in Germany, so families anywhere can find a plaque by name, surname or address and see its data and story. Motto: Cada placa, cada nombre, cada historia. Nunca olvidar.",
      "inLanguage": ["es", "de", "en"],
      "keywords": ["Stolpersteine", "Stumbling Stones", "Holocaust", "Shoah", "memorial", "Germany", "genealogy", "victims of National Socialism", "Gunter Demnig", "map"],
      "creator": {"@type": "Person", "name": "Carlos Kauffmann"},
      "spatialCoverage": {"@type": "Place", "name": "Germany"},
      "temporalCoverage": "1933/1945",
      "isAccessibleForFree": true,
      "license": "https://opendatacommons.org/licenses/odbl/1-0/",
      "isBasedOn": [
        {"@type": "Dataset", "name": "OpenStreetMap (memorial=stolperstein)", "url": "https://www.openstreetmap.org", "license": "https://opendatacommons.org/licenses/odbl/1-0/", "dateModified": "2026-11-04"},
        {"@type": "Dataset", "name": "Wikidata", "url": "https://www.wikidata.org", "license": "https://creativecommons.org/publicdomain/zero/1.0/", "dateModified": "2026-11-07"}
      ],
      "dateModified": "2026-11-07",
