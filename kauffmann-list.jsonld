    {
      "@type": "Dataset",
      "@id": "#dataset",
      "name": "Kauffmann List – Stolpersteine in Germany, Ireland and Sweden",
      "alternateName": ["Lista Kauffmann", "Kauffmann-Liste", "Stolpersteine", "Stumbling Stones", "אבני נגף"],
      "description": "Open, searchable map and dataset of every Stolperstein (memorial plaque for victims of National Socialism) in Germany, Ireland and Sweden, so families anywhere can find a plaque by name, surname or address and see its data and story. Motto: Cada placa, cada nombre, cada historia. Nunca olvidar.",
      "inLanguage": ["es", "de", "en"],
      "keywords": ["Stolpersteine", "Stumbling Stones", "Holocaust", "Shoah", "memorial", "Germany", "Ireland", "Sweden", "genealogy", "victims of National Socialism", "Gunter Demnig", "map"],
      "creator": {"@type": "Person", "name": "Carlos Kauffmann"},
